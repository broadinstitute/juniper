{
  "stableId": "studyStatus",
  "name": "Study Status",
  "surveyType": "ADMIN",
  "version": 1,
  "allowAdminEdit": true,
  "allowParticipantStart": false,
  "allowParticipantReedit": false,
  "autoAssign": true,
  "assignToExistingEnrollees": true,
  "required": false,
  "answerMappings": [],
  "jsonContent": {
    "title": {
      "en": "Study Status"
    },
    "pages": [
      {
        "elements": [
          {
            "type": "panel",
            "elements": [
              {
                "name": "acceptanceStatus",
                "title": {
                  "en": "Acceptance Status"
                },
                "isRequired": false,
                "type": "dropdown",
                "choices": [
                  {
                    "value": "ACCEPTED",
                    "text": {
                      "en": "Accepted"
                    }
                  },
                  {
                    "value": "IN_REVIEW",
                    "text": {
                      "en": "In Review"
                    }
                  },
                  {
                    "value": "MORE_INFO_NEEDED",
                    "text": {
                      "en": "More Info Needed"
                    }
                  },
                  {
                    "value": "NOT_ACCEPTED",
                    "text": {
                      "en": "Not Accepted"
                    }
                  },
                  {
                    "value": "NMI_TO_ACCEPT",
                    "text": {
                      "en": "NMI to Accepted"
                    }
                  },
                  {
                    "value": "PRE_REVIEW",
                    "text": {
                      "en": "Pre-review"
                    }
                  }
                ],
                "defaultValue": "PRE_REVIEW"
              },
              {
                "name": "acceptanceStatusDate",
                "title": {
                  "en": "Acceptance Status Date"
                },
                "isRequired": false,
                "type": "text",
                "inputType": "date"
              }
            ]
          },
          {
            "type": "panel",
            "elements": [
              {
                "name": "active",
                "title": {
                  "en": "Active/Inactive/HOLD"
                },
                "isRequired": false,
                "type": "dropdown",
                "choices": [
                  {
                    "value": "ACTIVE",
                    "text": {
                      "en": "Active"
                    }
                  },
                  {
                    "value": "HOLD",
                    "text": {
                      "en": "HOLD"
                    }
                  },
                  {
                    "value": "INACTIVE",
                    "text": {
                      "en": "Inactive"
                    }
                  }
                ],
                "defaultValue": "ACTIVE"
              },
              {
                "name": "inactiveReason",
                "title": {
                  "en": "Inactive Reason"
                },
                "isRequired": false,
                "type": "dropdown",
                "choices": [
                  {
                    "value": "WITHDREW",
                    "text": {
                      "en": "Withdrew"
                    }
                  },
                  {
                    "value": "DECLINED",
                    "text": {
                      "en": "Declined to Participate"
                    }
                  },
                  {
                    "value": "ENROLLED_INELIGIBLE",
                    "text": {
                      "en": "Enrolled-Ineligible"
                    }
                  },
                  {
                    "value": "COMPLETED",
                    "text": {
                      "en": "Completed"
                    }
                  },
                  {
                    "value": "LOST_TO_FOLLOWUP",
                    "text": {
                      "en": "Lost to Follow-up"
                    }
                  },
                  {
                    "value": "INELIGIBLE",
                    "text": {
                      "en": "Ineligible"
                    }
                  },
                  {
                    "value": "NA",
                    "text": {
                      "en": "N/A"
                    }
                  }
                ],
                "defaultValue": "NA"
              }
            ]
          },
          {
            "type": "panel",
            "elements": [
              {
                "name": "acuityAppointmentDate",
                "title": {
                  "en": "Acuity Appointment Date"
