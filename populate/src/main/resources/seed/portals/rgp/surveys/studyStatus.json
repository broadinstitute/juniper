                  "en": "Consent Documentation Complete"
                },
                "isRequired": false,
                "type": "radiogroup",
                "choices": [
                  {
                    "value": "YES",
                    "text": {
                      "en": "Yes"
                    }
                  },
                  {
                    "value": "NO",
                    "text": {
                      "en": "No"
                    }
                  }
                ]
              },
              {
                "name": "photoPermissions",
                "title": {
                  "en": "Photo Permissions"
                },
                "isRequired": false,
                "type": "dropdown",
                "choices": [
                  {
                    "value": "NA",
                    "text": {
                      "en": "N/A"
                    }
                  },
                  {
                    "value": "INTERNAL_ONLY",
                    "text": {
                      "en": "Internal only"
                    }
                  },
                  {
                    "value": "EXTERNAL_INTERNAL",
                    "text": {
                      "en": "External and Internal"
                    }
                  },
                  {
                    "value": "DECLINED",
                    "text": {
                      "en": "Declined"
                    }
                  },
                  {
                    "value": "OTHER",
                    "text": {
                      "en": "Other"
                    }
                  },
                  {
                    "value": "REQUESTED",
                    "text": {
                      "en": "Requested"
                    }
                  }
                ],
                "defaultValue": "NA"
              }
            ]
          }
        ]
      }
