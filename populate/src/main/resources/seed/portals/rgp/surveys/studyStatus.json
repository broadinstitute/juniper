                "isRequired": false,
                "type": "text",
                "inputType": "date"
              },
              {
                "name": "dateConsentCall",
                "title": {
                  "en": "Date of Consent Call"
                },
                "isRequired": false,
                "type": "text",
                "inputType": "date"
              },
