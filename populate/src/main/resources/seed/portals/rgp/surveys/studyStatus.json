                "isRequired": false,
                "type": "dropdown",
                "choices": [
                  {
                    "value": "HMB",
                    "text": {
                      "en": "HMB"
                    }
                  },
                  {
                    "value": "GRU",
                    "text": {
                      "en": "GRU"
                    }
                  },
                  {
                    "value": "UNKNOWN",
                    "text": {
                      "en": "Unknown"
                    }
                  }
                ],
                "defaultValue": "UNKNOWN"
              },
              {
                "name": "consentingNotes",
                "title": {
                  "en": "Consenting Notes"
                },
                "isRequired": false,
