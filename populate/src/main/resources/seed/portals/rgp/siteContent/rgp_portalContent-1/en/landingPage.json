    {
      "sectionType": "HERO_CENTERED",
      "sectionConfigJson": {
        "title": "",
        "blurb": "If you or your family member has a rare and genetically undiagnosed condition, you may be eligible to join a patient-driven amazing!!!!! search study aimed at discovering the genes underlying your family’s rare disease.",
        "blurbAlign": "center",
        "buttons": [],
        "blurbSize": "fs-2",
        "background": "#e8702a",
        "color": "#FFFFFF"
      }
    },
    {
      "sectionType": "HERO_WITH_IMAGE",
      "sectionConfigJson": {
        "title": "",
        "blurb": "The Rare Genomes Project (RGP) at the Broad Institute of MIT and Harvard is a patient-driven research study led by genomics experts and clinicians who believe that the latest advances in genomic sequencing are changing medicine and should be accessible to families with rare and undiagnosed conditions.",
        "fullWidth": true,
        "image": {
          "cleanFileName": "lgmd-centered-image-md.jpg",
          "version": 1
        },
        "imagePosition": "left",
        "background": "#FFFFFF",
        "buttons": [
          {
            "text": "Apply",
            "type": "join",
            "studyShortcode": "rgp"
          }
        ],
        "logos": [
          {
            "cleanFileName": "broad_logo.png",
            "version": 1,
            "alt": "Broad Institute logo",
            "link": "https://broadinstitute.org",
            "style": {
              "height": "40px"
            }
          }
        ],
        "imageAsBackground": false,
        "aspectRatio": ""
      }
    },
